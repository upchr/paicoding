# 环境变量配置示例
# 复制此文件为 .env 并修改相应的值
# 使用方法: cp .env.example .env
# 注意: .env 文件不会被提交到版本控制（已在 .gitignore 中）

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pai_coding_2026
DB_USERNAME=root
DB_PASSWORD=your_password_here

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Elasticsearch 配置
ES_URIS=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=

# RabbitMQ 配置
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# JWT 配置
JWT_SECRET=your_jwt_secret_here_change_in_production

# Knife4j 配置
KNIFE4J_PASSWORD=your_knife4j_password_here

# 安全配置
SECURITY_SALT=your_security_salt_here

# 邮件配置
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_email_password_here

# AI 配置
AI_ENABLED=false
AI_API_KEY=
AI_API_URL=

# 日志级别
LOG_LEVEL=info

# 图片上传路径
IMAGE_UPLOAD_PATH=/app/data/upload

# 管理员用户ID
ADMIN_USER_ID=1