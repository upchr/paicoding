# 环境变量配置示例
# 复制此文件为 .env 并修改相应的值
# 使用方法: cp .env.example .env
# 注意: .env 文件不会被提交到版本控制（已在 .gitignore 中）

# ========== 数据库配置 ==========
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pai_coding_2026
DB_USERNAME=root
DB_PASSWORD=your_password_here

# ========== Redis 配置 ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== Elasticsearch 配置 ==========
ES_URIS=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=

# ========== RabbitMQ 配置 ==========
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# RabbitMQ 开关（false 则不使用 RabbitMQ 功能）
RABBITMQ_ENABLED=false

# ========== JWT 配置 ==========
JWT_SECRET=your_jwt_secret_here_change_in_production

# ========== Knife4j 配置 ==========
KNIFE4J_PASSWORD=your_knife4j_password_here
# 生产环境是否禁用 API 文档
KNIFE4J_PRODUCTION=false
# API 文档访问认证开关
KNIFE4J_BASIC_ENABLE=false

# ========== 安全配置 ==========
SECURITY_SALT=your_security_salt_here
# 敏感词过滤开关
SENSITIVE_WORD_ENABLE=false

# ========== 邮件配置 ==========
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_email_password_here

# ========== AI 配置 ==========
# AI 开关
AI_ENABLED=false

# 代理配置（访问 OpenAI 需要）
PROXY_IP=
PROXY_PORT=
PROXY_TYPE=SOCKS

# AI 次数限制
AI_MAX_NUM_BASIC=5
AI_MAX_NUM_WECHAT=10
AI_MAX_NUM_STAR=30
AI_SOURCE=CHAT_GPT_3_5

# ChatGPT 配置
CHATGPT_MAIN=CHAT_GPT_3_5
CHATGPT_3_5_KEY=
CHATGPT_4_KEY=
CHATGPT_PROXY=false
CHATGPT_API_HOST=https://api.openai.com/
CHATGPT_NUM_NORMAL=50
CHATGPT_NUM_VIP=100

# 讯飞 AI 配置
XUNFEI_HOST_URL=https://spark-api.xf-yun.com/v1.1/chat
XUNFEI_DOMAIN=general
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# ========== 网站配置 ==========
SITE_NAME=技术派
SITE_HOST=http://localhost:8081
SITE_LOGO_URL=https://paicoding.com/img/logo.svg
SITE_FAVICON_URL=https://paicoding.com/img/icon.png
SITE_RECORD=
SITE_WELCOME=欢迎来到技术派
SITE_OSS_URL=
SITE_PAGE_SIZE=20
SITE_NEED_LOGIN_COUNT=30

# ========== 日志配置 ==========
LOG_LEVEL=info

# ========== 图片上传配置 ==========
IMAGE_UPLOAD_PATH=/app/data/upload

# ========== 管理员配置 ==========
ADMIN_USER_ID=1
